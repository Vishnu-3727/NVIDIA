# Python
__pycache__/
*.pyc
*.pyo
.venv/

# Large / binary profiling files — exceed GitHub limits or not diffable
**/*.nsys-rep
**/*.sqlite
**/phase4_ncu.ncu-rep

# Allow small targeted kernel reports
!**/phase4_conv_kernel.ncu-rep
!**/phase4_gemm_kernel.ncu-rep

# Allow small text stats exported from nsys (committable, diffable)
!**/*_stats.txt

# uv lock files
uv.lock

# OS
.DS_Store
Thumbs.db
desktop.ini

# Large model files
*.bin
*.engine
*.onnx
